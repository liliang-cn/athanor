# /etc/athanor/athanor.env — root:athanor, mode 0640.

# The brain. A SQLite file under the state directory, or a postgres:// DSN.
ATHANOR_DB=/var/lib/athanor/brain.db

# Both listeners. 127.0.0.1 keeps them on the host; use the LAN or Tailscale
# address to serve other machines. Transport is plaintext — trusted network or
# a TLS terminator in front.
ATHANOR_GRPC_ADDR=127.0.0.1:47831
ATHANOR_HTTP_ADDR=127.0.0.1:47832

# Scoped keys. One file, both ports, every door. Generate secrets with
# `openssl rand -hex 32`. See deploy/keys.example.json for the shape.
ATHANOR_KEY_FILE=/etc/athanor/keys.json

# Uploaded sources wait here while a job runs. Inside the state directory so
# ProtectSystem=strict allows it.
ATHANOR_SPOOL=/var/lib/athanor/spool

# Optional embedder for the brain's recall. Unset is lexical mode.
#OPENAI_BASE_URL=https://your-gateway/v1
#OPENAI_API_KEY=...
#CORTEXDB_EMBED_MODEL=embeddinggemma:latest
#CORTEXDB_EMBED_DIM=768
